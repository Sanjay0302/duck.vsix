{
  "name": "duckai",
  "publisher": "sanjaybyranna",
  "displayName": "duck.ai",
  "description": "DuckDuckGo AI Chat in VS Code",
  "icon": "media/icons/duckduckgo.256.255.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sanjay0302/duck.vsix/"
  },
  "version": "2.0.0",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "AI",
    "Chat"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "duck-chat",
          "title": "duck.ai",
          "icon": "media/icons/message.256.232.png"
        }
      ]
    },
    "views": {
      "duck-chat": [
        {
          "id": "duckChatView",
          "name": "",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "duck-vsix.startChat",
        "title": "Start Duck Chat"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "build": "node build.js",
    "vscode:prepublish": "npm run build",
    "audit": "npm audit --omit=dev --audit-level=high",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "dependencies": {
    "dompurify": "^3.4.0",
    "isolated-vm": "^6.2.0",
    "katex": "^0.16.9",
    "marked": "^11.1.1",
    "node-fetch": "^2.6.7"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/marked": "^5.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.16.0"
  },
  "overrides": {
    "serialize-javascript": "^7.1.0"
  }
}
